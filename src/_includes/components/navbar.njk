<nav class="retro-nav-bar" aria-label="Main Navigation">
  {% for item in site.nav %}
    <a href="{{ item.url }}" class="nav-btn {% if page.url == item.url %}active{% endif %}" {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
      {{ item.label }}
    </a>
  {% endfor %}
</nav>
